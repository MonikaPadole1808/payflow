+CREATE TABLE payments (
+    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    sender_wallet_id UUID NOT NULL,
+    receiver_wallet_id UUID NOT NULL,
+    amount NUMERIC(19, 2) NOT NULL,
